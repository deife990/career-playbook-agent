{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerpilot.local/schemas/story-bank.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "stories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "anyOf": [
          {
            "$ref": "https://careerpilot.local/schemas/entities.schema.json#/$defs/Story"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "stories"
  ],
  "additionalProperties": false
}
