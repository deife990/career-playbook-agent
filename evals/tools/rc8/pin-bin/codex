#!/bin/bash
# rc.8 final C: pin the rc.7-baseline model. CLI 0.160.1 changed the default to gpt-6.1-sol.
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL="$(PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$SELF_DIR" | paste -sd: -)" command -v codex)"
[ -n "$REAL" ] || { echo "pin-bin: real codex not found" >&2; exit 127; }
if [ "$1" = "exec" ]; then shift; exec "$REAL" exec -m gpt-5.6-sol "$@"; fi
exec "$REAL" "$@"
